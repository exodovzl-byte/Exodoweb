rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura para la sincronización en tiempo real de la tienda ÉXODO
    // Catálogo, configuración de marca, logos, precios, mockups, tesorería y pedidos OMS
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
